{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "API_PORT",
    "CORS_ORIGINS",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "AUTH_COOKIE_DOMAIN",
    "ENTRUST_ORG_ID",
    "NEXT_PUBLIC_API_URL",
    "API_URL",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "EMAIL_MODE",
    "CLEAR_APP_URL",
    "CONTACT_FROM_EMAIL",
    "ADMIN_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^test"
      ]
    }
  }
}
