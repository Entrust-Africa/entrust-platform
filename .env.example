# Postgres. Shared environments use Neon: paste the pooled connection string
# (it ends in ?sslmode=require). Local Postgres works for development.
DATABASE_URL=postgres://entrust:entrust@localhost:5432/entrust_platform

# API (apps/api)
API_PORT=4000
# Origins allowed to call the API with cookies (the CLEAR app and the website).
CORS_ORIGINS=http://localhost:3000,http://localhost:6001

# The Entrust organisation (id from core.organization). Its members with the roles admin,
# facilitator or reviewer are Entrust staff and see every case; unset, nobody is staff.
ENTRUST_ORG_ID=

# Better Auth runs inside the API. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
# Transactional email. In development (EMAIL_MODE=log), emails are logged to the API console.
# In production or EMAIL_MODE=send, both RESEND_API_KEY and a verified EMAIL_FROM domain (not onboarding@resend.dev)
# are required, and CLEAR_APP_URL must be set to your public domain (not localhost).
RESEND_API_KEY=
EMAIL_FROM=Entrust <onboarding@resend.dev>
CLEAR_APP_URL=http://localhost:3000
EMAIL_MODE=log
# Production only: share the session cookie across subdomains, e.g. .entrust-africa.com
AUTH_COOKIE_DOMAIN=

# CLEAR app (apps/clear): where it reaches the API, from the browser and from the server.
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

# Cloudflare R2 generic file storage (apps/api)
# Set FILE_STORAGE=memory for local development / testing (stores uploads in memory, no R2 needed).
# In staging/production, set FILE_STORAGE=r2 and configure R2 credentials below.
#
# Note: Cloudflare R2 bucket CORS configuration is required for direct browser uploads:
#   AllowedOrigins: ["http://localhost:3000", "https://*.entrust-africa.com"]
#   AllowedMethods: ["GET", "PUT", "HEAD"]
#   AllowedHeaders: ["content-type", "x-amz-checksum-sha256"]
#   ExposeHeaders: ["ETag", "x-amz-checksum-sha256"]
#   MaxAgeSeconds: 3600
FILE_STORAGE=memory
R2_BUCKET_NAME=entrust-files-dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: custom endpoint URL (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=
