# Postgres. Shared environments use Neon: paste the pooled connection string
# (it ends in ?sslmode=require). Local Postgres works for development.
DATABASE_URL=postgres://entrust:entrust@localhost:5432/entrust_platform

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
