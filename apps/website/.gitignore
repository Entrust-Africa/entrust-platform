# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules_prod
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files: never commit real values, only the .env.example template
.env
.env.*
!.env.example

# secrets / keys
*.pem
*.key

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cPanel / Passenger runtime (created on the server, not part of the source)
/tmp/
/.well-known/
/cgi-bin/

# local archives, backups and stray clones
*.zip
*.tar
*.tar.gz
/public_backup/
/entrust-africa/

# local-only data
/data/

# OS / editor / tooling
.DS_Store
.idea/
.vscode/
*.swp
.codex
.claude/
