# Copy this file to `.env` and fill in real values. `.env` is git-ignored; never commit it.
#   cp .env.example .env

# Resend API key used by the contact, event RSVP and newsletter API routes.
# Create one at https://resend.com/api-keys. (EMAIL_API_KEY / CONTACT_API_KEY are accepted as fallbacks.)
# Without a real key, forms return an error in production and a "not delivered" notice in development.
RESEND_API_KEY=

# Verified sender address in Resend, e.g. noreply@your-domain.com.
# Falls back to onboarding@resend.dev (Resend sandbox) if unset.
CONTACT_FROM_EMAIL=

# Where form submissions are delivered. Comma-separated for multiple recipients.
ADMIN_EMAIL=
